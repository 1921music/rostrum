{
  "name": "rostrum",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "pretest": "node build_browser_fs.mjs && python build.py --font",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:extension": "python build.py --extension && playwright test tests/extension-score.spec.js",
    "probe:pcloud-web": "node tests/static-server.js",
    "build:extension": "python build.py --extension"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "browser-fs-access": "0.38.0"
  }
}
